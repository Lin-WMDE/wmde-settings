[Desktop Entry]
Name=X11 Applications Compatibility
Comment=X11 window system application scaling, primary display, and global shortcuts.
Type=Application
Exec=wmde-settings legacy-applications
Terminal=false
Categories=WMDE
Keywords=WMDE;X11;Application;Game;Compatibility;
NoDisplay=true
OnlyShowIn=WMDE
Icon=preferences-x11-applications-compatibility
StartupNotify=true
